# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# WhatsApp Configuration (HTTP API Gateway)
# If using a local API gateway like Evolution API, wwebjs-aws, etc.
WHATSAPP_API_URL=http://localhost:8080/message/sendText
WHATSAPP_API_TOKEN=your_whatsapp_gateway_token_here
WHATSAPP_RECIPIENT_PHONE=your_whatsapp_recipient_phone_or_group_id_here

# Automation Settings
KIBANA_HEADLESS=True
KIBANA_TIMEOUT_MS=60000

# Loop Mode Settings (Optional, for Python background scheduler)
LOOP_INTERVAL_MINUTES=120
